{% if items.length %}
<ul class="posts">
  {% for post in items %}
  <li>
    <a href="{{ post.url }}">{{ post.title }}</a>
    {% if post.description %}<p>{{ post.description }}</p>{% endif %}
    <div class="meta">
      <time datetime="{{ post.date }}">{{ post.date | cnDate }}</time>
      {% for tag in post.tags %}<a href="/tags/{{ tag | tagPath | urlencode }}/">{{ tag }}</a>{% endfor %}
    </div>
  </li>
  {% endfor %}
</ul>
{% else %}
<p class="empty">{{ emptyText }}</p>
{% endif %}
