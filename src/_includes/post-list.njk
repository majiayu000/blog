{% if items.length %}
<ul class="posts{% if compactList %} posts--compact{% endif %}">
  {% for post in items %}
  <li class="post-card">
    <div class="post-card__content">
      {% if post.topic or post.tags.length %}
      <div class="post-card__top">
        {% if post.topic %}<span class="post-card__topic"><i aria-hidden="true"></i>{{ post.topic.title }}</span>{% else %}<span class="post-card__topic"><i aria-hidden="true"></i>{{ post.tags[0] }}</span>{% endif %}
      </div>
      {% endif %}
      <h2><a class="title" href="{{ post.url }}">{{ post.title }}</a></h2>
      {% if post.description %}<p class="post-card__description">{{ post.description }}</p>{% endif %}
      {% if post.tags.length %}
      <div class="post-card__tags">
        {% for tag in post.tags %}<a href="/tags/{{ tag | tagPath | urlencode }}/">#{{ tag }}</a>{% endfor %}
      </div>
      {% endif %}
      <div class="post-card__meta">
        <span class="post-card__byline">
          <time datetime="{{ post.date }}">{{ post.date | cnDate }}</time>
          {% if post.readingMinutes %}<span aria-hidden="true">·</span><span>约 {{ post.readingMinutes }} 分钟</span>{% endif %}
        </span>
        <span class="post-card__arrow" aria-hidden="true">→</span>
      </div>
    </div>
  </li>
  {% endfor %}
</ul>
{% else %}
<p class="empty">{{ emptyText }}</p>
{% endif %}
