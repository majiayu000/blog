<!doctype html>
<html lang="{{ site.language }}">
<head>
<meta charset="utf-8">
<meta name="viewport" content="width=device-width, initial-scale=1">
<title>{% if title %}{{ title | escape }} · {% endif %}{{ site.title | escape }}</title>
{% if site.description %}<meta name="description" content="{{ site.description | escape }}">{% endif %}
<link rel="canonical" href="{{ site.url | escape }}{{ page.url | escape }}">
<meta property="og:type" content="website">
<meta property="og:site_name" content="{{ site.title | escape }}">
<meta property="og:title" content="{% if title %}{{ title | escape }} · {% endif %}{{ site.title | escape }}">
{% if site.description %}<meta property="og:description" content="{{ site.description | escape }}">{% endif %}
<meta property="og:url" content="{{ site.url | escape }}{{ page.url | escape }}">
<meta name="twitter:card" content="summary">
<meta name="twitter:title" content="{% if title %}{{ title | escape }} · {% endif %}{{ site.title | escape }}">
{% if site.description %}<meta name="twitter:description" content="{{ site.description | escape }}">{% endif %}
<meta name="theme-color" content="#f6f3ec" media="(prefers-color-scheme: light)">
<meta name="theme-color" content="#131211" media="(prefers-color-scheme: dark)">
<link rel="alternate" type="application/rss+xml" title="{{ site.title }}" href="/feed.xml">
<script>
try {
  const savedTheme = localStorage.getItem("blog-theme");
  if (savedTheme === "light" || savedTheme === "dark") {
    document.documentElement.dataset.theme = savedTheme;
  }
} catch (error) {
  console.error("Unable to restore theme preference", error);
}
</script>
<link rel="stylesheet" href="/css/main.css">
<link rel="stylesheet" href="/css/support.css">
{% if extraHead %}{{ extraHead | safe }}{% endif %}
</head>
<body{% if navKey %} class="page-{{ navKey }}"{% endif %}>
<a class="skip-link" href="#main-content">跳到正文</a>
<header class="site-header">
  <div class="site-header__inner">
    <a class="site-title" href="/">
      <strong>{{ site.title }}</strong><span>/log</span>
    </a>
    <nav aria-label="主导航">
      <a href="/"{% if navKey == "home" %} aria-current="page"{% endif %}>首页</a>
      <a href="/archive/"{% if navKey == "archive" %} aria-current="page"{% endif %}>文章</a>
      <a href="/tags/"{% if navKey == "tags" %} aria-current="page"{% endif %}>主题</a>
      <a href="/#about">关于</a>
    </nav>
    <div class="site-actions">
      <a class="header-control" href="/search/"{% if navKey == "search" %} aria-current="page"{% endif %}>
        搜索 <span aria-hidden="true">/</span>
      </a>
      <button class="header-control" id="theme-toggle" type="button" aria-label="切换深浅色模式">
        深色 <span aria-hidden="true">DARK</span>
      </button>
    </div>
  </div>
</header>

<main id="main-content">
{{ content | safe }}
</main>

<footer class="site-footer">
  <div class="site-footer__inner">
    <div class="footer-brand"><strong>{{ site.title }}</strong><span>/log · building agents in public</span></div>
    <div class="footer-links">
      <a href="/feed.xml">RSS</a>
      <a href="https://github.com/majiayu000">GitHub</a>
      <span>© 2026 {{ site.title }}</span>
    </div>
  </div>
</footer>
<script>
(() => {
  const button = document.querySelector("#theme-toggle");
  if (!button) {
    console.error("Theme toggle button is missing");
    return;
  }

  const prefersDark = window.matchMedia("(prefers-color-scheme: dark)");
  const isDark = () =>
    document.documentElement.dataset.theme === "dark" ||
    (!document.documentElement.dataset.theme && prefersDark.matches);

  const updateLabel = () => {
    button.firstChild.textContent = isDark() ? "浅色 " : "深色 ";
    const label = button.querySelector("span");
    if (label) label.textContent = isDark() ? "LIGHT" : "DARK";
  };

  button.addEventListener("click", () => {
    const nextTheme = isDark() ? "light" : "dark";
    document.documentElement.dataset.theme = nextTheme;
    try {
      localStorage.setItem("blog-theme", nextTheme);
    } catch (error) {
      console.error("Unable to save theme preference", error);
    }
    updateLabel();
  });

  prefersDark.addEventListener("change", updateLabel);
  updateLabel();
})();
</script>
</body>
</html>
