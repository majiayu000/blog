---
layout: shell.njk
pagination:
  data: blog.tags
  size: 1
  alias: group
permalink: "/tags/{{ group.tag | tagPath }}/"
navKey: tags
extraHead: '<meta name="robots" content="noindex,follow">'
eleventyComputed:
  title: "标签：{{ group.tag }}"
---
<div class="page-shell">
  <header class="page-heading">
    <p class="eyebrow">// TOPIC</p>
    <h1>{{ group.tag }}</h1>
    <p>{{ group.posts.length }} 篇相关记录。</p>
  </header>

  {% set items = group.posts %}
  {% include "post-list.njk" %}

  <a class="back-link" href="/tags/">← 所有主题</a>
</div>
